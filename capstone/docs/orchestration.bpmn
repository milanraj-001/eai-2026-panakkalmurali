<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_checkout" targetNamespace="http://eai-2026/capstone">
  <bpmn:message id="Message_accepted" name="order.accepted" />
  <bpmn:error id="Error_provider" name="provider failure" errorCode="provider_failure" />
  <bpmn:process id="Process_checkout" name="Checkout saga" isExecutable="false">
    <bpmn:startEvent id="Start" name="order.accepted received">
      <bpmn:messageEventDefinition id="Start_def" messageRef="Message_accepted" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_type" name="orderType?" default="F_std" />
    <bpmn:serviceTask id="Task_payment" name="Authorize payment" />
    <bpmn:exclusiveGateway id="GW_merge" />
    <bpmn:serviceTask id="Task_inventory" name="Reserve inventory" />
    <bpmn:serviceTask id="Task_shipping" name="Create shipment" />
    <bpmn:serviceTask id="Task_notification" name="Send confirmation" />
    <bpmn:endEvent id="End_completed" name="completed" />
    <bpmn:serviceTask id="Task_refund" name="Refund payment" isForCompensation="true" />
    <bpmn:serviceTask id="Task_release" name="Release inventory" isForCompensation="true" />
    <bpmn:boundaryEvent id="B_pay_cmp" attachedToRef="Task_payment">
      <bpmn:compensateEventDefinition id="B_pay_cmp_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_inv_cmp" attachedToRef="Task_inventory">
      <bpmn:compensateEventDefinition id="B_inv_cmp_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_pay_err" attachedToRef="Task_payment">
      <bpmn:errorEventDefinition id="B_pay_err_def" errorRef="Error_provider" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_pay_tmo" attachedToRef="Task_payment">
      <bpmn:timerEventDefinition id="B_pay_tmo_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_inv_err" attachedToRef="Task_inventory">
      <bpmn:errorEventDefinition id="B_inv_err_def" errorRef="Error_provider" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_shp_err" attachedToRef="Task_shipping">
      <bpmn:errorEventDefinition id="B_shp_err_def" errorRef="Error_provider" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_shp_tmo" attachedToRef="Task_shipping">
      <bpmn:timerEventDefinition id="B_shp_tmo_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_ntf_err" attachedToRef="Task_notification">
      <bpmn:errorEventDefinition id="B_ntf_err_def" errorRef="Error_provider" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_failed" name="failed" />
    <bpmn:endEvent id="End_parked" name="parked (DLQ)" />
    <bpmn:intermediateThrowEvent id="Throw_comp" name="compensate">
      <bpmn:compensateEventDefinition id="Throw_comp_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="GW_comp" name="all compensations ok?" />
    <bpmn:endEvent id="End_compensated" name="compensated" />
    <bpmn:endEvent id="End_compfailed" name="compensation_failed" />
    <bpmn:sequenceFlow id="F_start" sourceRef="Start" targetRef="GW_type" />
    <bpmn:sequenceFlow id="F_std" sourceRef="GW_type" targetRef="Task_payment" name="not b2b" />
    <bpmn:sequenceFlow id="F_b2b" sourceRef="GW_type" targetRef="GW_merge" name="b2b: no payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderType == 'b2b'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_pay_ok" sourceRef="Task_payment" targetRef="GW_merge" />
    <bpmn:sequenceFlow id="F_merge" sourceRef="GW_merge" targetRef="Task_inventory" />
    <bpmn:sequenceFlow id="F_inv_ok" sourceRef="Task_inventory" targetRef="Task_shipping" />
    <bpmn:sequenceFlow id="F_shp_ok" sourceRef="Task_shipping" targetRef="Task_notification" />
    <bpmn:sequenceFlow id="F_ntf_ok" sourceRef="Task_notification" targetRef="End_completed" />
    <bpmn:sequenceFlow id="F_pay_err" sourceRef="B_pay_err" targetRef="End_failed" />
    <bpmn:sequenceFlow id="F_pay_tmo" sourceRef="B_pay_tmo" targetRef="End_parked" />
    <bpmn:sequenceFlow id="F_inv_err" sourceRef="B_inv_err" targetRef="Throw_comp" />
    <bpmn:sequenceFlow id="F_shp_err" sourceRef="B_shp_err" targetRef="Throw_comp" />
    <bpmn:sequenceFlow id="F_shp_tmo" sourceRef="B_shp_tmo" targetRef="Throw_comp" />
    <bpmn:sequenceFlow id="F_ntf_err" sourceRef="B_ntf_err" targetRef="Throw_comp" />
    <bpmn:sequenceFlow id="F_comp" sourceRef="Throw_comp" targetRef="GW_comp" />
    <bpmn:sequenceFlow id="F_comp_ok" sourceRef="GW_comp" targetRef="End_compensated" name="all succeeded" />
    <bpmn:sequenceFlow id="F_comp_bad" sourceRef="GW_comp" targetRef="End_compfailed" name="a call failed" />
    <bpmn:association id="A_pay" sourceRef="B_pay_cmp" targetRef="Task_refund" associationDirection="One" />
    <bpmn:association id="A_inv" sourceRef="B_inv_cmp" targetRef="Task_release" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_checkout">
    <bpmndi:BPMNPlane id="Plane_checkout" bpmnElement="Process_checkout">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="62" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_type_di" bpmnElement="GW_type" isMarkerVisible="true">
        <dc:Bounds x="165" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_payment_di" bpmnElement="Task_payment">
        <dc:Bounds x="280" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_merge_di" bpmnElement="GW_merge" isMarkerVisible="true">
        <dc:Bounds x="445" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_inventory_di" bpmnElement="Task_inventory">
        <dc:Bounds x="560" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_shipping_di" bpmnElement="Task_shipping">
        <dc:Bounds x="720" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_notification_di" bpmnElement="Task_notification">
        <dc:Bounds x="880" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_completed_di" bpmnElement="End_completed">
        <dc:Bounds x="1052" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_refund_di" bpmnElement="Task_refund">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_release_di" bpmnElement="Task_release">
        <dc:Bounds x="560" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_pay_cmp_di" bpmnElement="B_pay_cmp">
        <dc:Bounds x="312" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_inv_cmp_di" bpmnElement="B_inv_cmp">
        <dc:Bounds x="592" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_pay_err_di" bpmnElement="B_pay_err">
        <dc:Bounds x="272" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_pay_tmo_di" bpmnElement="B_pay_tmo">
        <dc:Bounds x="352" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_inv_err_di" bpmnElement="B_inv_err">
        <dc:Bounds x="582" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_shp_err_di" bpmnElement="B_shp_err">
        <dc:Bounds x="732" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_shp_tmo_di" bpmnElement="B_shp_tmo">
        <dc:Bounds x="792" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_ntf_err_di" bpmnElement="B_ntf_err">
        <dc:Bounds x="912" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_failed_di" bpmnElement="End_failed">
        <dc:Bounds x="272" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_parked_di" bpmnElement="End_parked">
        <dc:Bounds x="352" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Throw_comp_di" bpmnElement="Throw_comp">
        <dc:Bounds x="762" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_comp_di" bpmnElement="GW_comp" isMarkerVisible="true">
        <dc:Bounds x="875" y="455" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_compensated_di" bpmnElement="End_compensated">
        <dc:Bounds x="992" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_compfailed_di" bpmnElement="End_compfailed">
        <dc:Bounds x="882" y="552" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_start_di" bpmnElement="F_start">
        <di:waypoint x="98" y="260" />
        <di:waypoint x="165" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_std_di" bpmnElement="F_std">
        <di:waypoint x="215" y="260" />
        <di:waypoint x="280" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_b2b_di" bpmnElement="F_b2b">
        <di:waypoint x="190" y="235" />
        <di:waypoint x="190" y="40" />
        <di:waypoint x="470" y="40" />
        <di:waypoint x="470" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_pay_ok_di" bpmnElement="F_pay_ok">
        <di:waypoint x="380" y="260" />
        <di:waypoint x="445" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_merge_di" bpmnElement="F_merge">
        <di:waypoint x="495" y="260" />
        <di:waypoint x="560" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_inv_ok_di" bpmnElement="F_inv_ok">
        <di:waypoint x="660" y="260" />
        <di:waypoint x="720" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_shp_ok_di" bpmnElement="F_shp_ok">
        <di:waypoint x="820" y="260" />
        <di:waypoint x="880" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ntf_ok_di" bpmnElement="F_ntf_ok">
        <di:waypoint x="980" y="260" />
        <di:waypoint x="1052" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_pay_err_di" bpmnElement="F_pay_err">
        <di:waypoint x="290" y="318" />
        <di:waypoint x="290" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_pay_tmo_di" bpmnElement="F_pay_tmo">
        <di:waypoint x="370" y="318" />
        <di:waypoint x="370" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_inv_err_di" bpmnElement="F_inv_err">
        <di:waypoint x="600" y="318" />
        <di:waypoint x="600" y="390" />
        <di:waypoint x="780" y="390" />
        <di:waypoint x="780" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_shp_err_di" bpmnElement="F_shp_err">
        <di:waypoint x="750" y="318" />
        <di:waypoint x="750" y="390" />
        <di:waypoint x="780" y="390" />
        <di:waypoint x="780" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_shp_tmo_di" bpmnElement="F_shp_tmo">
        <di:waypoint x="810" y="318" />
        <di:waypoint x="810" y="390" />
        <di:waypoint x="780" y="390" />
        <di:waypoint x="780" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ntf_err_di" bpmnElement="F_ntf_err">
        <di:waypoint x="930" y="318" />
        <di:waypoint x="930" y="390" />
        <di:waypoint x="780" y="390" />
        <di:waypoint x="780" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_comp_di" bpmnElement="F_comp">
        <di:waypoint x="798" y="480" />
        <di:waypoint x="875" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_comp_ok_di" bpmnElement="F_comp_ok">
        <di:waypoint x="925" y="480" />
        <di:waypoint x="992" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_comp_bad_di" bpmnElement="F_comp_bad">
        <di:waypoint x="900" y="505" />
        <di:waypoint x="900" y="552" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A_pay_di" bpmnElement="A_pay">
        <di:waypoint x="330" y="202" />
        <di:waypoint x="330" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A_inv_di" bpmnElement="A_inv">
        <di:waypoint x="610" y="202" />
        <di:waypoint x="610" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
